design.v
module gray_to_binary(
    input  [3:0] G,
    output [3:0] B
);

assign B[3] = G[3];
assign B[2] = G[3] ^ G[2];
assign B[1] = G[3] ^ G[2] ^ G[1];
assign B[0] = G[3] ^ G[2] ^ G[1] ^ G[0];

endmodule

tb.v
module tb_gray_to_binary;

reg [3:0] G;
wire [3:0] B;


gray_to_binary DUT(
    .G(G),
    .B(B)
);

