design.v
module half_adder(input a,b output sum,carry);
xor(sum a,b)
and(carry a,b)
endmodule

tb.v

module tb_half_adder;
reg a;
reg b;
wire sum,carry;
half_adder dut(.a(a),
               .b(b),
               .sum(sum),
               .carry(carry),);
               initial begin
                $display("a b |sum carry");
                $display("-----------");
                a=0;b=0;
                #10;
                $display("%b %b |%b %b ",a,b,sum,carry);
               a=0;b=1;
                #10;
                $display("%b %b |%b %b ",a,b,sum,carry);
                a=1;b=0;
                #10;
                $display("%b %b |%b %b ",a,b,sum,carry);
                a=1;b=1;
                #10;
                $display("%b %b |%b %b ",a,b,sum,carry);
                $finish;
               end 
endmodule
