    #10;
    $display("%b | %b|  %b", A, B, Y);

    A = 1;
    B = 1;
    #10;
    $display("%b | %b |  %b", A, B, Y);

    A = 1;
    B = 1;
    #10;
    $display("%b | %b|  %b", A, B, Y);

    $finish;

end
endmodule
