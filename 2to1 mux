design.v
module mux2to1(
    input I0,
    input I1,
    input S,
    output Y
);

assign Y = S ? I1 : I0;
endmodule
module or_using_mux(
    input A,
    input B,
    output Y
);
wire I0;
wire I1;
assign I0 = A;
assign I1 = 1'b1;
mux2to1 MUX1(
    .I0(I0),
    .I1(I1),
    .S(B),
    .Y(Y)
);
endmodule

tb.v

module tb_or_using_mux;
reg A;
reg B;
wire Y;

or_using_mux DUT(
    .A(A),
    .B(B),
    .Y(Y)
);

initial begin
$dumpfile("dump.vcd");
$dumpvars(0,tb_or_using_mux);
    $display("A  B | Y");
    $display("--------");

    A = 1;
