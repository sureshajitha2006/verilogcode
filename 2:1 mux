 module mux2to1(
    input I0,
    input I1,
    input S,
    output Y
);

wire Sbar;

not (Sbar, S);

and (w1, I0, Sbar);
and (w2, I1, S);
or (Y, w1, w2);
endmodule

module mux2to1(
    input I0,
    input I1,
    input S,
    output Y
);

wire Sbar;
wire w1, w2;

not (Sbar, S);
and (w1, I0, Sbar);
and (w2, I1, S);
or  (Y, w1, w2);

endmodule

