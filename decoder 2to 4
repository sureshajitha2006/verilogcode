design.v
module decoder2to4(
    input A,
    input B,
    input E,
    output Y0,
    output Y1,
    output Y2,
    output Y3
);

wire Abar;
wire Bbar;
not (Abar, A);
not (Bbar, B);
and (Y0, E, Abar, Bbar);
and (Y1, E, Abar, B);
and (Y2, E, A, Bbar);
and (Y3, E, A, B);

endmodule

